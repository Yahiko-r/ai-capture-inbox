{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Capture Inbox",
  "version": "0.1.0",
  "identifier": "com.yahiko.ai-capture-inbox",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI Capture Inbox",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
